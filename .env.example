# llmgw4j environment variables example
# Copy to `.env` (already git-ignored) and fill in real values.
# Never commit real credentials — see SECURITY.md and docs/CONFIGURATION.md §6.

# --- Required by the application -------------------------------------------

# Admin token for /admin/* endpoints (route hot-reload, snapshots, key listing).
# When both admin tokens are empty, management data APIs are open (local demo only).
# A read token alone never authorizes management writes; production requires the full token.
# Generate: openssl rand -hex 24
LLMGW_ADMIN_TOKEN=

# Upstream provider API key (OpenAI-compatible, e.g. DashScope compatible-mode).
# Empty = gateway sends no Authorization header to the upstream.
# Injected via ${DASHSCOPE_API_KEY:} in application.yml / application-real.yml.
DASHSCOPE_API_KEY=

# --- Optional: Spring Boot relaxed binding (usually leave unset) -----------
# PORT=8080
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379

# --- Optional: run/bench scripts (bin/*.sh, bench/*.sh) --------------------
# PORT=8080                  # gateway port used by run-webflux.sh / run-vt.sh
# MOCK_PORT=9090             # built-in mock upstream port
# GATEWAY_GC_OPTS=-XX:MaxGCPauseMillis=10
# JAVA_HOME=/path/to/jdk     # required only for bin/build-native.sh

# Production is opt-in and requires replacing demo routes/keys and disabling mock.
# GATEWAY_PRODUCTION=true
# GATEWAY_ADMIN_READ_TOKEN=  # audit export only; must differ from full token
# GATEWAY_AUTH_JWT_AUDIENCE=your-service
