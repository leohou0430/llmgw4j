  <artifactId>llmgw-recording-local</artifactId>
  <name>llmgw-recording-local</name>
  <description>Local (single-node) recording store: bounded async writer with an
    explicit health gate, sanitizer for credentials/URLs/binary fragments,
    idempotent terminal outcomes and 7-day body retention via an injectable
    Clock.</description>

  <properties><llmgw.foundation.enforcer.skip>false</llmgw.foundation.enforcer.skip></properties>
  <dependencies>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-recording-api</artifactId></dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
