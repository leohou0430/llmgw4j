{
  "schema": "llmgw-acceptance-fixture/v1",
  "id": "messages-s3-tool-call-continuation",
  "entry": "messages",
  "scenario": 3,
  "slug": "tool-call-continuation",
  "title": "工具调用→客户端执行→结果续轮",
  "mock": {
    "chunks": 4
  },
  "markers": [
    "mock-deepseek-tools",
    "mock-deepseek"
  ],
  "steps": [
    {
      "name": "initial",
      "request": {
        "model": "mock-model",
        "messages": [
          {
            "role": "user",
            "content": "mock-deepseek-tools: What is the weather in SF?"
          }
        ],
        "tools": [
          {
            "name": "get_weather",
            "description": "Mock-fixed weather tool: the controlled upstream always calls it with {\"city\":\"SF\"}.",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "add_numbers",
            "description": "Deterministic integer addition for controlled acceptance runs.",
            "input_schema": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "integer"
                },
                "b": {
                  "type": "integer"
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            }
          }
        ],
        "tool_choice": {
          "type": "auto"
        },
        "thinking": {
          "type": "disabled"
        },
        "max_tokens": 1024,
        "stream": false
      },
      "expected": {
        "transport": "json",
        "terminal": {
          "type": "message",
          "role": "assistant",
          "stop_reason": "tool_use",
          "stop_sequence_null": true,
          "content_block_types": [
            "tool_use"
          ]
        },
        "tool_calls": [
          {
            "id": "call_mock_1",
            "name": "get_weather",
            "arguments": {
              "city": "SF"
            }
          }
        ],
        "usage": {
          "input_tokens": 4,
          "cache_read_input_tokens": 3,
          "cache_creation_input_tokens": 0,
          "output_tokens": 1,
          "absent_fields": [
            "usage.total_tokens",
            "usage.output_tokens_details"
          ]
        }
      }
    },
    {
      "name": "continuation",
      "request": {
        "model": "mock-model",
        "messages": [
          {
            "role": "user",
            "content": "What is the weather in SF?"
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "call_mock_1",
                "name": "get_weather",
                "input": {
                  "city": "SF"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "call_mock_1",
                "content": "{\"city\":\"SF\",\"temperature_c\":18,\"condition\":\"sunny\"}"
              },
              {
                "type": "text",
                "text": "mock-deepseek: Answer using the tool result."
              }
            ]
          }
        ],
        "tools": [
          {
            "name": "get_weather",
            "description": "Mock-fixed weather tool: the controlled upstream always calls it with {\"city\":\"SF\"}.",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "add_numbers",
            "description": "Deterministic integer addition for controlled acceptance runs.",
            "input_schema": {
              "type": "object",
              "properties": {
                "a": {
                  "type": "integer"
                },
                "b": {
                  "type": "integer"
                }
              },
              "required": [
                "a",
                "b"
              ],
              "additionalProperties": false
            }
          }
        ],
        "tool_choice": {
          "type": "auto"
        },
        "thinking": {
          "type": "disabled"
        },
        "max_tokens": 1024,
        "stream": false
      },
      "expected": {
        "transport": "json",
        "terminal": {
          "type": "message",
          "role": "assistant",
          "stop_reason": "end_turn",
          "stop_sequence_null": true,
          "content_block_types": [
            "text"
          ]
        },
        "text": {
          "equals": "Hello world"
        },
        "usage": {
          "input_tokens": 4,
          "cache_read_input_tokens": 3,
          "cache_creation_input_tokens": 0,
          "output_tokens": 1,
          "absent_fields": [
            "usage.total_tokens",
            "usage.output_tokens_details"
          ]
        }
      }
    }
  ],
  "notes": "Marker hygiene: the continuation history carries no mock-deepseek-tools marker so the controlled upstream answers text after the tool result; the plain mock-deepseek marker lives only in the active turn. Responses continuation uses input items (function_call + function_call_output); previous_response_id is rejected by the gateway (no conversation storage)."
}
