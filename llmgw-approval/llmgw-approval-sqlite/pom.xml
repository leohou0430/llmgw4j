  <artifactId>llmgw-approval-sqlite</artifactId>
  <name>llmgw-approval-sqlite</name>
  <description>SQLite approval store: durable CAS state machine (PENDING → APPROVED |
    REJECTED | EXPIRED; APPROVED → REVOKED), expiry observed on decision,
    revalidation of subject + params digest before every execution.</description>

  <properties><llmgw.foundation.enforcer.skip>false</llmgw.foundation.enforcer.skip></properties>
  <dependencies>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-approval-api</artifactId></dependency>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-persistence-api</artifactId></dependency>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-persistence-sqlite</artifactId></dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
