  <artifactId>llmgw-conversion-gemini</artifactId>
  <name>llmgw-conversion-gemini</name>
  <description>Task-7 Gemini entry codec: /v1beta/models/{model}:generateContent |
    streamGenerateContent | countTokens only (no arbitrary path forwarding),
    model extracted from the URL path with injection rejected, and the Gemini
    response shape (candidates/parts/usageMetadata) mapped onto the semantic
    contract. No Spring/Reactor/HTTP dependency.</description>

  <properties><llmgw.foundation.enforcer.skip>false</llmgw.foundation.enforcer.skip></properties>
  <dependencies>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-conversion-api</artifactId></dependency>
    <dependency><groupId>io.github.leohou0430</groupId><artifactId>llmgw-core</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
