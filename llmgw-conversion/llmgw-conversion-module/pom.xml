  <artifactId>llmgw-conversion-module</artifactId>
  <name>llmgw-conversion-module</name>
  <description>Named conversion ExtensionModule: discovers the entry/upstream codecs by SPI and orchestrates them behind ConversionService</description>
  <properties><llmgw.foundation.enforcer.skip>false</llmgw.foundation.enforcer.skip></properties>
  <dependencies>
