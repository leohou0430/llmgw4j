# ---- Build outputs ----
target/
*.class
*.jar
*.jar.original
!.mvn/wrapper/maven-wrapper.jar
llmgw-app/target/native/
bin/native/

# ---- Local JDK / GraalVM toolchains (NOT redistributable, hundreds of MB) ----
# Ignore toolchain children but keep the versioned acceptance fixtures (T1.9/T1.13)
# under tools/acceptance/ trackable: a parent-dir exclusion cannot be re-included.
tools/*
!tools/acceptance/
*.tar.gz
*.tgz
*.zip
*.dmg

# ---- Local runtime data & secrets ----
data/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
application-local.yaml
llmgw-snapshot.json
# Runtime SQLite files created when a process cwd is llmgw-app/ (tests/smokes).
llmgw-app/*.db
llmgw-app/*.db-shm
llmgw-app/*.db-wal

# ---- Benchmark artifacts (raw CSV, jars, logs, manifests, local classpaths) ----
bench/results/
bench/micro/.classpath*
bench/micro/.classes/
bench/micro/.lib/
*.log
*.rss

# ---- IDE / OS ----
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.DS_Store
Thumbs.db

# ---- Python helpers ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Bench helper compile output ----
bench/mock/*.class

# Local semantic index.
.codegraph/
